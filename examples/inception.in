;; Demonstrate using a macro to create a "structure", complete with accessors
;; type-checking and mutators.
;;
;; This example *ONLY* works in inception, because our compiler doesn't
;; support such advanced macros.



;; Make a symbol
(defun make-symbol (name)
  (list "symbol" name))

;; Get the name of a symbol
(defun symbol-name (x)
  (cadr x))

;; Create a function
(defun make-defun (name args &body)
  (append
    (list
      (make-symbol "defun")
      (make-symbol name)
      args)
    body))

;; create a constructor
(defun struct-constructor (type fields)
  (let ((args (map make-symbol fields)))
    (make-defun
      (strcat "make-" type)
      args
      (cons
        (make-symbol "list")
        (cons
          (list
            (make-symbol "quote")
            (make-symbol type))
          args)))))

;; create a field-accessing method
(defun struct-accessor (type field index)
  (make-defun
    (strcat (strcat type "-") field)
    (list (make-symbol "obj"))
    (list
      (make-symbol "nth")
      (make-symbol "obj")
      (+ index 1))))

;; Create a settr for a field
(defun struct-setter (type field index)
  (make-defun
    (strcat
      (strcat
        "set-"
        (strcat type "-"))
      (strcat field "!"))
    (list
      (make-symbol "obj")
      (make-symbol "value"))
    (list
      (make-symbol "nth!")
      (make-symbol "obj")
      (+ index 1)
      (make-symbol "value"))))

;; Test a thing is an instance of a type
(defun struct-predicate (type)
  (make-defun
    (strcat type "?")
    (list (make-symbol "obj"))
    (list
      (make-symbol "=")
      (list
        (make-symbol "symbol-name")
        (list
          (make-symbol "car")
          (make-symbol "obj")))
      type)))

;; Build the getter/setters for each field
(defun build-accessors (type fields index)
  (if (nil? fields)
      nil
      (cons
        (struct-accessor type
                         (car fields)
                         index)

        (cons
          (struct-setter type
                         (car fields)
                         index)

          (build-accessors type
                           (cdr fields)
                           (+ index 1))))))

;; Nirvana: Define everything for the object
(defmacro defstruct (spec)
  (let ((type   (symbol-name (car spec)))
        (fields (map symbol-name (cdr spec))))
    (cons
      (make-symbol "do")
      (cons
        (struct-constructor type fields)
         (cons
          (struct-predicate type)

          (build-accessors type
                           fields
                           0))))))


;; Test code

;; Define a "person" with three fields
;;   name
;;   address
;;   email
(defstruct (person name address email))

;; Make a person - all fields set
(let ((p (make-person "Dave" "Somewhere in London" "steve@steve.example")))

  ;; Show it
  (println "raw representation of a person:" p )

  ;; Confirm we have the type-check
  (if (person? p)
      (println "we made a person!")
      (println "person? failed for p"))

  ;; Set a field
  (println "before:"p)
  (set-person-email! p "anonymous@example.com")
  (println "after:"p)

  ;; Get field values, by name
  (println "Name:"    (person-name p))
  (println "Address:" (person-address p))

  )
